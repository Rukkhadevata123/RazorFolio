<Project>
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <PackAsTool>false</PackAsTool>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <!-- This CLI hosts Kestrel directly; the base SDK does not apply the Web SDK's IIS asset filter. -->
  <Target Name="ExcludeIISHostingAsset" AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="CopyFilesToPublishDirectory">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                            Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'"
                            CopyToPublishDirectory="Never" />
    </ItemGroup>
  </Target>
</Project>
