<Project Sdk="Microsoft.NET.Sdk">


  <ItemGroup>
    <EmbeddedResource Include="Styles/theme.css" LogicalName="RazorFolio.Themes.Default.theme.css" />
    <EmbeddedResource Include="Styles/code.css" LogicalName="RazorFolio.Themes.Default.code.css" />
    <EmbeddedResource Include="Styles/search.css" LogicalName="RazorFolio.Themes.Default.search.css" />
    <EmbeddedResource Include="Styles/mermaid.css" LogicalName="RazorFolio.Themes.Default.mermaid.css" />
    <EmbeddedResource Include="Styles/math.css" LogicalName="RazorFolio.Themes.Default.math.css" />
    <EmbeddedResource Include="Scripts/math.js" LogicalName="RazorFolio.Themes.Default.math.js" />
    <EmbeddedResource Include="Scripts/vendor/katex/katex.min.js" LogicalName="RazorFolio.Themes.Default.katex.min.js" />
    <EmbeddedResource Include="Scripts/vendor/katex/katex.min.css" LogicalName="RazorFolio.Themes.Default.katex.min.css" />
    <EmbeddedResource Include="Scripts/vendor/katex/LICENSE.txt" LogicalName="RazorFolio.Themes.Default.katex-LICENSE.txt" />
    <EmbeddedResource Include="Scripts/vendor/katex/fonts/*" LogicalName="RazorFolio.Themes.Default.katex.fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Scripts/code-blocks.js" LogicalName="RazorFolio.Themes.Default.code-blocks.js" />
    <EmbeddedResource Include="Scripts/theme.js" LogicalName="RazorFolio.Themes.Default.theme.js" />
    <EmbeddedResource Include="Scripts/search.js" LogicalName="RazorFolio.Themes.Default.search.js" />
    <EmbeddedResource Include="Scripts/mermaid.js" LogicalName="RazorFolio.Themes.Default.mermaid.js" />
    <EmbeddedResource Include="Scripts/vendor/mermaid.tiny.js" LogicalName="RazorFolio.Themes.Default.mermaid.tiny.js" />
    <EmbeddedResource Include="Scripts/vendor/mermaid-LICENSE.txt" LogicalName="RazorFolio.Themes.Default.mermaid-LICENSE.txt" />
    <EmbeddedResource Include="Scripts/vendor/highlight.min.js" LogicalName="RazorFolio.Themes.Default.highlight.min.js" />
    <EmbeddedResource Include="Scripts/vendor/highlight-LICENSE.txt" LogicalName="RazorFolio.Themes.Default.highlight-LICENSE.txt" />
    <ProjectReference Include="../RazorFolio.TemplateCompiler/RazorFolio.TemplateCompiler.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed;IsAotCompatible"
                      AdditionalProperties="PublishAot=false;PublishTrimmed=false;SelfContained=false" />
    <ProjectReference Include="../RazorFolio.Core/RazorFolio.Core.csproj" />
  </ItemGroup>
  <Target Name="CompileRazorTemplates" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../RazorFolio.TemplateCompiler/RazorFolio.TemplateCompiler.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed;IsAotCompatible">
      <Output TaskParameter="TargetOutputs" ItemName="_TemplateCompilerAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_GeneratedRazorDirectory>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)Razor', '$(MSBuildProjectDirectory)'))</_GeneratedRazorDirectory>
    </PropertyGroup>
    <Exec Command="dotnet &quot;@(_TemplateCompilerAssembly)&quot; &quot;$(MSBuildProjectDirectory)/Views&quot; &quot;$(_GeneratedRazorDirectory)&quot;" />
    <ItemGroup>
      <Compile Remove="$(_GeneratedRazorDirectory)/*.g.cs" />
      <Compile Include="$(_GeneratedRazorDirectory)/*.g.cs" />
      <FileWrites Include="$(_GeneratedRazorDirectory)/*.g.cs" />
    </ItemGroup>
  </Target>
</Project>
