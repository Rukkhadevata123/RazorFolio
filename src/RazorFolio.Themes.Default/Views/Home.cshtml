@model RazorFolio.Core.Rendering.HomePage
@using System.Globalization
@{
    ViewData["Title"] = Model.Site.Title;
    ViewData["Language"] = Model.Site.Language;
}

<h1>@Model.Site.Title</h1>
@if (Model.Articles.Count == 0)
{
    <p>还没有文章。</p>
}
else
{
    <ul>
        @foreach (var article in Model.Articles)
        {
            <li>
                <a href="@article.Url">@article.Title</a>
                @if (article.Date is { } date)
                {
                    var dateText = date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                    <time class="article-date" datetime="@dateText">@dateText</time>
                }
            </li>
        }
    </ul>
}
