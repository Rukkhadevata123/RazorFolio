@model RazorFolio.Core.Rendering.HomePage
@{
    ViewData["Title"] = "RazorFolio";
}

<h1>文章</h1>
@if (Model.Articles.Count == 0)
{
    <p>还没有文章。</p>
}
else
{
    <ul>
        @foreach (var article in Model.Articles)
        {
            <li><a href="@article.Url">@article.Title</a></li>
        }
    </ul>
}
