@inherits global::RazorFolio.Themes.Default.Rendering.PageTemplate<RazorFolio.Core.Rendering.HomePage>
@{
    var firstPage = Model.Pagination.CurrentPage == 1;
    var theme = Model.Context.Theme;
    Metadata.Title = firstPage ? Model.Context.Site.Title : $"{Model.Context.Site.Title} — 第 {Model.Pagination.CurrentPage} 页";
    Metadata.Description = Model.Context.Site.Description;
    Metadata.CssClass = "home-page";
}
@if (theme.Hero is { } hero)
{
    <section class="hero @(hero.FullScreen ? "" : "hero-compact")" aria-label="博客介绍"
             data-background-mode="@hero.Background.Mode">
        @if (hero.Background.Mode != "none" && hero.Background.Image is { } background)
        {
            <img class="hero-background" src="@background" alt="">
        }
        <div class="hero-content">
            @if (hero.Image is { } image)
            {
                <img src="@image" width="136" height="136" alt="">
            }
            <h1>@hero.Title</h1>
            @if (hero.Description is { } description)
            {
                <p>@description</p>
            }
            <a href="#rf-articles">向下阅读 ↓</a>
        </div>
        <p class="hero-credit" hidden></p>
    </section>
}
<div class="home-content" id="rf-articles">
    @if (theme.Hero is null)
    {
        <header class="page-heading">
            <h1>@Model.Context.Site.Title</h1>
            @if (Model.Context.Site.Description is { } description)
            {
                <p>@description</p>
            }
        </header>
    }
    <div class="section-heading">
        <h2 id="rf-articles-title">文章</h2>
        @await PartialAsync(new Shared__BrowseLinks { Model = Model.Context })
    </div>
    <div class="home-grid @(theme.Profile is null ? "without-profile" : "")">
        <section class="home-feed" data-home-feed aria-labelledby="rf-articles-title" tabindex="-1">
            <div data-page-content data-page="@Model.Pagination.CurrentPage" aria-busy="false">
                @if (Model.Articles.Count == 0)
                {
                    <p class="card empty-state">还没有文章。</p>
                }
                else
                {
                    @await PartialAsync(new Shared__ArticleList { Model = Model.Articles })
                }
                @if (Model.Pagination.TotalPages > 1)
                {
                    <nav class="pagination" aria-label="文章列表分页">
                        @if (Model.Pagination.PreviousUrl is { } previousUrl)
                        {
                            <a href="@(previousUrl + "#rf-articles")" rel="prev" data-page="@(Model.Pagination.CurrentPage - 1)">← 上一页</a>
                        }
                        <span aria-current="page">第 @Model.Pagination.CurrentPage 页，共 @Model.Pagination.TotalPages 页</span>
                        @if (Model.Pagination.NextUrl is { } nextUrl)
                        {
                            <a href="@(nextUrl + "#rf-articles")" rel="next" data-page="@(Model.Pagination.CurrentPage + 1)">下一页 →</a>
                        }
                    </nav>
                }
            </div>
            <p class="pagination-status" data-pagination-status role="status" aria-live="polite"></p>
        </section>
        @if (theme.Profile is { } profile)
        {
            @await PartialAsync(new Shared__Profile { Model = profile })
        }
    </div>
</div>
