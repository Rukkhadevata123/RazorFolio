@model RazorFolio.Core.Rendering.HomePage
@{
    ViewData["Title"] = Model.Pagination.CurrentPage == 1
        ? Model.Context.Site.Title
        : $"{Model.Context.Site.Title} — 第 {Model.Pagination.CurrentPage} 页";
    ViewData["Description"] = Model.Context.Site.Description;
}

<h1>@Model.Context.Site.Title</h1>
@if (Model.Context.Site.Description is { } description)
{
    <p class="site-description">@description</p>
}
@if (Model.ArchivesUrl is { } archivesUrl)
{
    <p><a href="@archivesUrl">按年份浏览</a></p>
}
@if (Model.CategoriesUrl is { } categoriesUrl)
{
    <p><a href="@categoriesUrl">按分类浏览</a></p>
}
@if (Model.TagsUrl is { } tagsUrl)
{
    <p><a href="@tagsUrl">按标签浏览</a></p>
}
@if (Model.Articles.Count == 0)
{
    <p>还没有文章。</p>
}
else
{
    @await Html.PartialAsync("/Views/Shared/_ArticleList.cshtml", Model.Articles)
}

@if (Model.Pagination.TotalPages > 1)
{
    <nav class="pagination" aria-label="文章列表分页">
        @if (Model.Pagination.PreviousUrl is { } previousUrl)
        {
            <a href="@previousUrl" rel="prev">上一页</a>
        }
        <span aria-current="page">第 @Model.Pagination.CurrentPage 页，共 @Model.Pagination.TotalPages 页</span>
        @if (Model.Pagination.NextUrl is { } nextUrl)
        {
            <a href="@nextUrl" rel="next">下一页</a>
        }
    </nav>
}
