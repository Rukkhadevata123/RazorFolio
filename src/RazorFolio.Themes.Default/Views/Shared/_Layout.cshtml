@using RazorFolio.Core.Rendering
@{
    var feed = ViewData["Feed"] as FeedLink;
}
<!doctype html>
<html lang="@ViewData["Language"]">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description">
    }
    @if (ViewData["CanonicalUrl"] is string canonicalUrl)
    {
        <link rel="canonical" href="@canonicalUrl">
    }
    @if (feed is not null)
    {
        <link rel="alternate" type="application/rss+xml" title="RSS" href="@feed.AbsoluteUrl">
    }
    @if (ViewData["StylesheetUrls"] is IReadOnlyList<string> stylesheetUrls)
    {
        @foreach (var stylesheetUrl in stylesheetUrls)
        {
            <link rel="stylesheet" href="@stylesheetUrl">
        }
    }
</head>
<body>
    <main>
        @RenderBody()
    </main>
    @if (feed is not null)
    {
        <footer class="site-footer">
            <a href="@feed.RelativeUrl">RSS 订阅</a>
        </footer>
    }
</body>
</html>
