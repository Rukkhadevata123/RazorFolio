@model RazorFolio.Core.Rendering.IPageModel
@{
    var context = Model.Context;
    var feed = context.Feed;
}
<!doctype html>
<html lang="@context.Site.Language">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    @if (context.FaviconUrl is { } faviconUrl)
    {
        <link rel="icon" type="image/svg+xml" href="@faviconUrl">
    }
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description">
    }
    @if (context.CanonicalUrl is { } canonicalUrl)
    {
        <link rel="canonical" href="@canonicalUrl">
    }
    @if (feed is not null)
    {
        <link rel="alternate" type="application/rss+xml" title="RSS" href="@feed.AbsoluteUrl">
    }
    @foreach (var stylesheetUrl in context.StylesheetUrls)
    {
        <link rel="stylesheet" href="@stylesheetUrl">
    }
</head>
<body>
    @if (context.Navigation.Count > 0)
    {
        <nav class="site-navigation" aria-label="主导航">
            <ul>
                @foreach (var link in context.Navigation)
                {
                    <li><a href="@link.Url">@link.Text</a></li>
                }
            </ul>
        </nav>
    }
    <main>
        @RenderBody()
    </main>
    @if (feed is not null)
    {
        <footer class="site-footer">
            <a href="@feed.RelativeUrl">RSS 订阅</a>
        </footer>
    }
</body>
</html>
