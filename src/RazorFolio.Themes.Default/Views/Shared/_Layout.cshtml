@model RazorFolio.Core.Rendering.IPageModel
@{
    var context = Model.Context;
    var brand = context.Theme.Brand;
}
<!doctype html>
<html lang="@context.Site.Language">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    @if (context.FaviconUrl is { } faviconUrl)
    {
        <link rel="icon" type="image/svg+xml" href="@faviconUrl">
    }
    @if (ViewData["Description"] is string description)
    {
        <meta name="description" content="@description">
    }
    @if (context.CanonicalUrl is { } canonicalUrl)
    {
        <link rel="canonical" href="@canonicalUrl">
    }
    @if (context.Feed is { } feed)
    {
        <link rel="alternate" type="application/rss+xml" title="RSS" href="@feed.AbsoluteUrl">
    }
    @foreach (var stylesheetUrl in context.StylesheetUrls)
    {
        <link rel="stylesheet" href="@stylesheetUrl">
    }
    @* Apply the saved color before paint; storage may be unavailable. *@
    <script>
        try {
            const mode = localStorage.getItem("razorfolio-color-mode");
            if (mode === "light" || mode === "dark") document.documentElement.dataset.theme = mode;
        } catch { }
    </script>
    @foreach (var scriptUrl in context.ScriptUrls)
    {
        <script src="@scriptUrl" defer></script>
    }
</head>
<body>
    <a class="skip" href="#rf-main">跳至正文</a>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="@context.HomeUrl">
                @if (brand.Image is { } image)
                {
                    <img src="@image" width="34" height="34" alt="">
                }
                <span>@brand.Text</span>
            </a>
            @if (context.Navigation.Count > 0)
            {
                <nav class="site-navigation desktop-navigation" aria-label="主导航">
                    @await Html.PartialAsync("_NavigationItems", context)
                </nav>
            }
            <button class="theme-toggle" type="button" data-theme-toggle hidden>切换配色</button>
            @if (context.Navigation.Count > 0)
            {
                <details class="mobile-navigation">
                    <summary>导航</summary>
                    <nav class="site-navigation" aria-label="主导航">
                        @await Html.PartialAsync("_NavigationItems", context)
                    </nav>
                </details>
            }
        </div>
    </header>
    <main id="rf-main" tabindex="-1" class="@(ViewData["PageClass"] ?? "archive-shell")">
        @RenderBody()
    </main>
    <footer class="site-footer">
        @if (context.Theme.Footer is { } footer)
        {
            <span>@footer</span>
        }
        @if (context.Feed is { } footerFeed)
        {
            <a href="@footerFeed.RelativeUrl">RSS 订阅</a>
        }
        <span>由 RazorFolio 生成</span>
    </footer>
</body>
</html>
