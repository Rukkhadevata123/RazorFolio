@inherits global::RazorFolio.Themes.Default.Rendering.RazorTemplate<RazorFolio.Core.Rendering.PageContext>
<dialog id="rf-search" class="search-dialog" aria-labelledby="rf-search-title" data-index-url="@Model.SearchIndexUrl">
    <div class="search-heading">
        <h2 id="rf-search-title">站内搜索</h2>
        <button type="button" data-search-close aria-label="关闭搜索">关闭</button>
    </div>
    <form class="search-form" role="search">
        <label for="rf-search-query">搜索关键词</label>
        <div class="search-input-row">
            <input id="rf-search-query" type="search" name="q" maxlength="200" autocomplete="off"
                   spellcheck="false" placeholder="搜索文章和页面" aria-describedby="rf-search-help" autofocus>
            <button type="submit">搜索</button>
        </div>
        <p id="rf-search-help">搜索标题、标签和正文；用空格分隔的关键词需同时匹配。</p>
    </form>
    <div class="search-feedback">
        <p data-search-status role="status" aria-live="polite" aria-atomic="true">输入关键词开始搜索。</p>
        <button type="button" data-search-retry hidden>重试</button>
    </div>
    <ol class="search-results" aria-label="搜索结果" aria-busy="false"></ol>
</dialog>
