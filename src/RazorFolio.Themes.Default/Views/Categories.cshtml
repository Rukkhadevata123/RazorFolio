@inherits global::RazorFolio.Themes.Default.Rendering.PageTemplate<RazorFolio.Core.Rendering.CategoryArchivePage>
@{
    Metadata.Title = $"分类归档 — {Model.Context.Site.Title}";
    Metadata.CssClass = "archive-shell category-archive";
}

<nav aria-label="站点导航">
    <a href="@Model.HomeUrl">← 返回首页</a>
</nav>

<h1>分类归档</h1>
@await PartialAsync(new Shared__BrowseLinks { Model = Model.Context })
@if (Model.Groups.Count == 0)
{
    <p class="empty-state">还没有分类。</p>
}
<ul class="archive-index" aria-label="分类索引">
    @foreach (var group in Model.Groups)
    {
        <li><a href="#@group.Id">@group.Name <span class="count">@group.Articles.Count</span></a></li>
    }
</ul>
@foreach (var group in Model.Groups)
{
    <section class="archive-group" aria-labelledby="@group.Id">
        <h2 id="@group.Id">@group.Name <span class="count">@group.Articles.Count 篇</span></h2>
        @await PartialAsync(new Shared__ArchiveEntries { Model = group.Articles })
    </section>
}
