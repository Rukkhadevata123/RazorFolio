@model RazorFolio.Core.Rendering.CategoryArchivePage
@{
    ViewData["Title"] = $"分类归档 — {Model.Context.Site.Title}";
}

<nav aria-label="站点导航">
    <a href="@Model.HomeUrl">← 返回首页</a>
</nav>

<h1>分类归档</h1>
@await Html.PartialAsync("_BrowseLinks", Model.Context)
<ul class="archive-index" aria-label="分类索引">
    @foreach (var group in Model.Groups)
    {
        <li><a href="#@group.Id">@group.Name <span class="count">@group.Articles.Count</span></a></li>
    }
</ul>
@foreach (var group in Model.Groups)
{
    <section class="archive-group" aria-labelledby="@group.Id">
        <h2 id="@group.Id">@group.Name <span class="count">@group.Articles.Count 篇</span></h2>
        @await Html.PartialAsync("/Views/Shared/_ArticleList.cshtml", group.Articles)
    </section>
}
