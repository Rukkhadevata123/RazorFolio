@inherits global::RazorFolio.Themes.Default.Rendering.PageTemplate<RazorFolio.Core.Rendering.ArticlePage>
@using System.Globalization
@{
    Metadata.Title = $"{Model.Info.Title} — {Model.Context.Site.Title}";
    Metadata.Description = Model.Info.Description;
    Metadata.CssClass = "article-page";
    var hasSidebar = Model.Context.Theme.Sidebar.Count > 0;
}
<div class="article-grid @(Model.Headings.Count == 0 ? "without-toc" : "") @(hasSidebar ? "" : "without-sidebar")">
    @if (hasSidebar)
    {
        <aside class="site-sidebar">
            <h2>浏览</h2>
            @await PartialAsync(new Shared__Sidebar { Model = Model.Context })
        </aside>
    }
    <div class="article-surface card">
        @if (hasSidebar)
        {
            <details class="mobile-sidebar">
                <summary>浏览文章</summary>
                @await PartialAsync(new Shared__Sidebar { Model = Model.Context })
            </details>
        }
        <article>
            <header class="article-header">
                <div class="article-tools">
                    <nav class="breadcrumb" aria-label="站点导航"><a href="@Model.HomeUrl">← 返回首页</a></nav>
                    <button type="button" data-print-article hidden>打印文章</button>
                </div>
                <p class="print-status" data-print-status role="status" hidden></p>
                @if (Model.TitleHtml is { } titleHtml)
                {
                    @Raw(titleHtml)
                }
                else
                {
                    <h1>@Model.Info.Title</h1>
                }
                @if (Model.Info.Draft)
                {
                    <p class="draft-label">草稿 · 仅供开发预览</p>
                }
                @if (Model.Info.IsArticle && Model.Info.Date is { } date)
                {
                    var dateText = date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                    <p class="article-date"><time datetime="@dateText">@dateText</time></p>
                }
                @if (Model.Categories.Count > 0)
                {
                    <ul class="article-categories" aria-label="文章分类">
                        @foreach (var category in Model.Categories)
                        {
                            <li><a href="@category.Url">@category.Name</a></li>
                        }
                    </ul>
                }
                @if (Model.Tags.Count > 0)
                {
                    <ul class="article-tags" aria-label="文章标签">
                        @foreach (var tag in Model.Tags)
                        {
                            <li><a href="@tag.Url">#@tag.Name</a></li>
                        }
                    </ul>
                }
            </header>
            @if (Model.Headings.Count > 0)
            {
                <details class="mobile-toc">
                    <summary><span>此页内容</span><span class="toc-current" aria-hidden="true"></span></summary>
                    @await PartialAsync(new Shared__TableOfContents { Model = Model.Headings })
                </details>
            }
            @* The HTML is rendered from trusted author content, including the original leading H1. *@
            <div class="article-body">@Raw(Model.BodyHtml)</div>
        </article>
        @if (Model.Navigation.Previous is not null || Model.Navigation.Next is not null)
        {
            <nav class="article-navigation" aria-label="文章导航">
                @if (Model.Navigation.Previous is { } previous)
                {
                    <a href="@previous.Url" rel="prev"><span>上一篇</span>@previous.Info.Title</a>
                }
                @if (Model.Navigation.Next is { } next)
                {
                    <a href="@next.Url" rel="next"><span>下一篇</span>@next.Info.Title</a>
                }
            </nav>
        }
    </div>
    @if (Model.Headings.Count > 0)
    {
        <aside class="page-toc">
            <h2>此页内容</h2>
            @await PartialAsync(new Shared__TableOfContents { Model = Model.Headings })
        </aside>
    }
</div>
@await PartialAsync(new Shared__CodeBlockScripts { Model = Model })
