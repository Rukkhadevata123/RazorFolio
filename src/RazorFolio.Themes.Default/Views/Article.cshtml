@model RazorFolio.Core.Rendering.ArticlePage
@using System.Globalization
@{
    ViewData["Title"] = $"{Model.Info.Title} — {Model.Context.Site.Title}";
    ViewData["Description"] = Model.Info.Description;
}

<nav aria-label="站点导航">
    <a href="@Model.HomeUrl">← 返回首页</a>
</nav>

<article>
    @if (Model.Info.Draft)
    {
        <p><strong>草稿</strong> · 仅供开发预览</p>
    }

    @if (Model.Info.Date is { } date)
    {
        var dateText = date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        <p class="article-date"><time datetime="@dateText">@dateText</time></p>
    }

    @if (Model.Tags.Count > 0)
    {
        <ul class="article-tags" aria-label="文章标签">
            @foreach (var tag in Model.Tags)
            {
                <li><a href="@tag.Url">@tag.Name</a></li>
            }
        </ul>
    }

    @* BodyHtml comes from the author's Markdown; ordinary text stays HTML-encoded. *@
    @Html.Raw(Model.BodyHtml)
</article>

@if (Model.Navigation.Previous is not null || Model.Navigation.Next is not null)
{
    <nav class="article-navigation" aria-label="文章导航">
        @if (Model.Navigation.Previous is { } previous)
        {
            <p>上一篇：<a href="@previous.Url" rel="prev">@previous.Info.Title</a></p>
        }
        @if (Model.Navigation.Next is { } next)
        {
            <p>下一篇：<a href="@next.Url" rel="next">@next.Info.Title</a></p>
        }
    </nav>
}
