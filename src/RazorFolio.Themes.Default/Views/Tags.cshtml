@inherits global::RazorFolio.Themes.Default.Rendering.PageTemplate<RazorFolio.Core.Rendering.TagArchivePage>
@{
    Metadata.Title = $"标签归档 — {Model.Context.Site.Title}";
}

<nav aria-label="站点导航">
    <a href="@Model.HomeUrl">← 返回首页</a>
</nav>

<h1>标签归档</h1>
@await PartialAsync(new Shared__BrowseLinks { Model = Model.Context })
@if (Model.Groups.Count == 0)
{
    <p class="empty-state">还没有标签。</p>
}
<ul class="archive-index" aria-label="标签索引">
    @foreach (var group in Model.Groups)
    {
        <li><a href="@group.Url">@group.Name <span class="count">@group.Articles.Count</span></a></li>
    }
</ul>
@foreach (var group in Model.Groups)
{
    <section class="archive-group" aria-labelledby="@group.Id">
        <h2 id="@group.Id"><a href="@group.Url">@group.Name</a> <span class="count">@group.Articles.Count 篇</span></h2>
        @await PartialAsync(new Shared__ArchiveEntries { Model = group.Articles })
    </section>
}
